# ==============================================================================
# Git Ignore Configuration - NYC Taxi R Analytics Project
# Author: praveena611 (YuvaIntern Virtual R Data Analyst Internship)
# ==============================================================================

# Large Raw and Processed Datasets (Do NOT commit huge binary/data files)
data/raw/*.parquet
data/raw/*.csv
data/cleaned/*.parquet
data/cleaned/*.csv
!data/raw/.gitkeep
!data/cleaned/.gitkeep

# Local Portable R Environment and Extractor Binaries
R_runtime/
innoextract_bin/

# R Environment, History & User Data
.Rhistory
.RData
.Ruserdata
.Renviron
.Rproj.user/
renv/library/
renv/staging/
renv/local/
renv/cellar/

# Python & System caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*.tmp
*.log

# Sensitive Credentials & Secrets
.env
*.pem
*.key
credentials.json
